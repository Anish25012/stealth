{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stealth broker registry",
  "type": "object",
  "required": ["version", "brokers"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "brokers": {"type": "array", "items": {"$ref": "#/$defs/broker"}}
  },
  "$defs": {
    "broker": {
      "type": "object",
      "required": [
        "id", "name", "domain", "region", "category", "method", "email", "form_url",
        "notes", "source", "last_verified", "laws", "tier", "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "name": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "pattern": "^[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"},
        "reply_domains": {
          "type": "array",
          "description": "Other domains this company replies from.",
          "items": {"type": "string"}
        },
        "region": {"enum": ["UK", "EU", "US", "GLOBAL", "UNKNOWN"]},
        "category": {
          "enum": [
            "data-aggregator", "marketing-list", "location-tracking", "people-search",
            "social-scraper", "public-records", "other"
          ]
        },
        "method": {"enum": ["email", "form"]},
        "email": {"type": ["string", "null"], "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"},
        "form_url": {"type": ["string", "null"]},
        "notes": {"type": "string"},
        "source": {"type": "string", "minLength": 1},
        "last_verified": {"type": "string"},
        "laws": {"type": "array", "items": {"type": "string"}},
        "tier": {"enum": ["core", "extended"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"method": {"const": "email"}}},
          "then": {"properties": {"email": {"type": "string"}}}
        },
        {
          "if": {"properties": {"method": {"const": "form"}}},
          "then": {"properties": {"form_url": {"type": "string"}}}
        }
      ]
    }
  }
}
